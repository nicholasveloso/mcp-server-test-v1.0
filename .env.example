# Copy this to .env or .env.debug

# Tavily
TAVILY_API_KEY=

# Postgres
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Optional table/columns
PG_TABLE_NAME=documents
PG_TEXT_COLUMN=content
PG_EMBEDDING_COLUMN=embedding
PG_METADATA_COLUMN=metadata

# Hybrid weights
HYBRID_TEXT_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5

# pgai options
PGAI_ENABLED=false
PGAI_MODEL=text-embedding-3-small

# Optional SSH tunnel
SSH_TUNNEL_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PRIVATE_KEY_FILE=/app/secrets/keys/bastion.pem